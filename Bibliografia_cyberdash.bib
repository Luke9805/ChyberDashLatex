@article{addis_llm-based_2026,
    title = {{LLM}-Based Intelligent Agents for Cybersecurity: A Tutorial and Survey of Automated Vulnerability Discovery},
    volume = {14},
    issn = {2169-3536},
    url = {https://ieeexplore.ieee.org/document/11580353/citations},
    doi = {10.1109/ACCESS.2026.3707573},
    shorttitle = {{LLM}-Based Intelligent Agents for Cybersecurity},
    abstract = {This paper provides a tutorial and survey of {LLM}-based agents for automated vulnerability discovery and penetration testing. The rapid advancements in Large Language Models ({LLMs}) have opened new possibilities for their application in cybersecurity. Unlike traditional tools, {LLMs} can process natural language, retain context, and perform structured reasoning, enabling automation of complex security workflows. By equipping these models with memory mechanisms and tool-use interfaces, researchers have developed {LLM}-driven autonomous agents capable of performing specialized tasks such as web application testing, source code auditing, fuzzing, and network security assessment. Multi-agent architectures have emerged in which agents assume specialized roles (e.g., distinct penetration-test phases or exploit types). In addition to surveying existing applications, this work provides a step-by-step walkthrough of integrating agentic {AI} into penetration testing workflows. The walkthrough explores four phases: (I) mission scoping and prompt engineering for test definition and constraint enforcement, ({II}) autonomous exploration and tool selection for target interaction, ({III}) vulnerability hypothesis formation and verification through experiment design and feedback, and ({IV}) payload generation and refinement to transform validated findings into concrete exploits. The survey synthesizes 155 cited sources (2022–early 2026) using explicit inclusion/exclusion criteria, with coverage extending to reasoning-class models, the Model Context Protocol ecosystem, autonomous bug-bounty agents, and standardized agentic security benchmarks. Despite progress, challenges persist, such as model hallucination, context limitations, operating costs, and ethical concerns. Future directions include advancements in multi-agent collaboration, mechanisms for agent self-improvement, and improved transparency into agent behavior.},
    pages = {100884--100917},
    journal = {{IEEE} Access},
    author = {Addis, Robel and Porter, Kiran and Ryan, Jayden and Stull, Micah and Xu, Shengjie and Wagner, Paul and Honomichl, Robert and Forsyth, Steven},
    urldate = {2026-10-28},
    year = {2026},
    keywords = {Computer security, {AI} agents, autonomous penetration testing, chain-of-thought ({CoT}), Cognition, Cognitive systems, Context, cybersecurity, Large language models, Large language models ({LLMs}), Modeling, multi-agent systems, Penetration testing, Plan-then-Execute ({PtE}), prompt engineering, {ReAct}, Security, static application security testing ({SAST}), Surveys, Tools, vulnerability discovery},
    file = {Full Text PDF:/home/Luca/Zotero/storage/AB3X3UII/Addis et al. - 2026 - LLM-Based Intelligent Agents for Cybersecurity A Tutorial and Survey of Automated Vulnerability Dis.pdf:application/pdf},
}

@inproceedings{alkhunaizi_toward_2025,
    title = {Toward a Centralized Solution for Aggregating Penetration Testing and Risk Mitigation*},
    issn = {2770-7466},
    url = {https://ieeexplore.ieee.org/abstract/document/11442208},
    doi = {10.1109/3ict68299.2025.11442208},
    abstract = {As cybersecurity threats escalate, organizations struggle to track vulnerabilities and manage them efficiently. Existing tools produce fragmented reports that complicate decision-making for both technical and non-technical users. This research proposes a centralized, dockerized solution that consolidates multi-source vulnerability data into a single interface. The platform integrates multiple vulnerability scanning tools to analyze specific {IP} addresses, unifies their outputs, and leverages containerization for scalable deployment. By incorporating a local Large Language Model ({LLM}), the system automatically interprets scan results, generates {AI}-driven reports, and provides personalized recommendations tailored to organizational roles. A customizable dashboard further supports visualization and monitoring, bridging the gap between technical findings and executive decision-making. The solution was evaluated through experimental scans that demonstrated successful tool integration, accurate data consolidation, and effective generation of context-aware reports. Leveraging Large Language Models ({LLMs}), the solution generates tailored recommendations and training to address specific security issues. Designed for adaptability and scalability, the proposed system contributes a practical framework that enhances vulnerability management, reduces response times, and improves overall organizational resilience against evolving cybersecurity threats.},
    eventtitle = {2025 International Conference on Innovation and Intelligence for Informatics, Computing, and Technologies (3ICT)},
    pages = {1--8},
    booktitle = {2025 International Conference on Innovation and Intelligence for Informatics, Computing, and Technologies (3ICT)},
    author = {Alkhunaizi, Maryam Moosa and Shehada, Taif Nabeel and Aldoseri, Abdulla},
    urldate = {2026-10-28},
    year = {2025},
    note = {{ISSN}: 2770-7466},
    keywords = {Large language models, Penetration testing, Decision making, Organizations, Resilience, Risk mitigation, Scalability, Technological innovation, Time factors, Training},
    file = {Full Text PDF:/home/Luca/Zotero/storage/X8W6K7YB/Alkhunaizi et al. - 2025 - Toward a Centralized Solution for Aggregating Penetration Testing and Risk Mitigation.pdf:application/pdf},
